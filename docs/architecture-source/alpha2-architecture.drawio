        </mxCell>
        <mxCell id="yb-d-title" parent="1" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;fontFamily=Helvetica;" value="&lt;b&gt;D · Diagnostics and state boundaries&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="600" x="85" y="1315" as="geometry" />
        </mxCell>
