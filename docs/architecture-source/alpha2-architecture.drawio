          <mxGeometry height="145" width="430" x="700" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="yb-count" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#d97706;fontFamily=Helvetica;fontColor=#0f172a;strokeWidth=1.3;" value="50 consecutive&lt;br&gt;stable samples?" vertex="1">
