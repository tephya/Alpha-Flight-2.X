          <mxGeometry height="40" width="1100" x="85" y="445" as="geometry" />
        </mxCell>
        <mxCell id="yb-init-decision" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#d97706;fontFamily=Helvetica;fontColor=#0f172a;strokeWidth=1.3;" value="Yaw state&lt;br&gt;initialized?" vertex="1">
