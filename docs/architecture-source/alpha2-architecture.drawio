          <mxGeometry height="125" width="500" x="70" y="1380" as="geometry" />
        </mxCell>
        <mxCell id="yb-invariant" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7f7;strokeColor=#dc2626;fontFamily=Helvetica;fontColor=#991b1b;arcSize=6;strokeWidth=1.3;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;" value="&lt;b&gt;Flight-safety invariant&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;While Armed, an anomalous Mag sample can be diagnosed and rejected,&lt;br&gt;but cannot directly rebase the absolute Yaw state.&lt;/span&gt;" vertex="1">
          <mxGeometry height="125" width="500" x="650" y="1380" as="geometry" />
        </mxCell>
        <mxCell id="yb-state" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f8ff;strokeColor=#2563eb;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.3;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;" value="&lt;b&gt;Persistent-state ownership&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;s_yaw owns fused Yaw, Field Reference and Reacquire tracker.&lt;br&gt;Diagnostics are copied out for Blackbox; callers do not mutate state.&lt;/span&gt;" vertex="1">
          <mxGeometry height="125" width="500" x="1230" y="1380" as="geometry" />
        </mxCell>
