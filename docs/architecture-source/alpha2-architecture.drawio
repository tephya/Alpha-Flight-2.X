        </mxCell>
        <mxCell id="yb-initialize" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fbf8;strokeColor=#16a34a;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.35;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;Initialize absolute Yaw&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;yaw = mag_yaw · innovation = 0&lt;br&gt;use calibrated Field Reference if valid;&lt;br&gt;otherwise use current field norm&lt;br&gt;accepted = true · reset tracker&lt;/span&gt;" vertex="1">
