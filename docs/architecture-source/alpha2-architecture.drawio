        <mxCell id="bp-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#0f172a;fontFamily=Helvetica;" value="Blackbox Persistence &amp; Offline Diagnosis" vertex="1">
          <mxGeometry height="45" width="1050" x="45" y="25" as="geometry" />
        </mxCell>
        <mxCell id="bp-sub" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#64748b;fontFamily=Helvetica;" value="Real-time producers only copy complete records to RAM · one background owner performs every FatFS operation" vertex="1">
          <mxGeometry height="20" width="1250" x="45" y="70" as="geometry" />
        </mxCell>
        <mxCell id="bp-page-label" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=1;fontColor=#64748b;fontFamily=Helvetica;" value="12 · BLACKBOX / PERSISTENCE / ANALYSIS" vertex="1">
          <mxGeometry height="25" width="430" x="1300" y="35" as="geometry" />
        </mxCell>
        <mxCell id="bp-a-mark" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2563eb;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="30" width="5" x="70" y="115" as="geometry" />
        </mxCell>
        <mxCell id="bp-a-title" parent="1" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;fontFamily=Helvetica;" value="&lt;b&gt;A · Producer-side record path&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748b;&quot;&gt;Each snapshot is built from one control cycle before it enters shared storage; no producer performs SD I/O&lt;/span&gt;" vertex="1">
          <mxGeometry height="40" width="1280" x="85" y="110" as="geometry" />
        </mxCell>
        <mxCell id="bp-producers" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f8ff;strokeColor=#2563eb;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.35;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;Real-time and event producers&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;Control V4 ≈ 200 Hz&lt;br&gt;Navigation V5 ≈ 20 Hz&lt;br&gt;ARM / IMU switch / voltage / dual fault&lt;br&gt;Mag calibration samples&lt;/span&gt;" vertex="1">
          <mxGeometry height="145" width="300" x="70" y="195" as="geometry" />
        </mxCell>
        <mxCell id="bp-snapshot" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fbf8;strokeColor=#16a34a;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.35;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;Build an immutable snapshot&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;DWT timestamp + targets + measurements&lt;br&gt;PID terms + motor values + estimator state&lt;br&gt;quality, mode and reject flags&lt;/span&gt;" vertex="1">
          <mxGeometry height="145" width="330" x="430" y="195" as="geometry" />
        </mxCell>
        <mxCell id="bp-frame" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#d97706;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.35;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;Frame packed binary record&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,monospace;font-size:11px;color:#475569;&quot;&gt;[0xAA MAGIC][TYPE][PAYLOAD…]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;Control V4 = 90 B · Navigation V5 = 76 B&lt;br&gt;compile-time Size Checks guard protocol drift&lt;/span&gt;" vertex="1">
          <mxGeometry height="145" width="330" x="820" y="195" as="geometry" />
        </mxCell>
        <mxCell id="bp-writebytes" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f8ff;strokeColor=#2563eb;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.35;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b style=&quot;font-family:Consolas,monospace;&quot;&gt;BB_WriteBytes()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;copy complete record bytes into RAM&lt;br&gt;record may cross one block boundary&lt;br&gt;rollback on failed block switch&lt;/span&gt;" vertex="1">
          <mxGeometry height="145" width="300" x="1210" y="195" as="geometry" />
        </mxCell>
        <mxCell id="bp-fill" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf3;strokeColor=#f97316;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.35;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;Current FILLING block&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;4 KiB in DMA_SAFE_SRAM&lt;br&gt;512-byte sector multiple&lt;br&gt;RAM copy only&lt;/span&gt;" vertex="1">
          <mxGeometry height="145" width="180" x="1570" y="195" as="geometry" />
        </mxCell>
        <mxCell id="bp-a-invariant" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fbf8;strokeColor=#16a34a;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;Real-time ownership invariant&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;FlightCtrl records only current-cycle values, so one log record cannot combine targets, measurements and outputs from different scheduler cycles.&lt;/span&gt;" vertex="1">
          <mxGeometry height="70" width="800" x="70" y="380" as="geometry" />
        </mxCell>
        <mxCell id="bp-rate-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#d97706;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;Buffer sizing rationale&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;Control V4 is roughly 18 KiB/s at 200 Hz; two 4 KiB blocks absorb only short SD stalls, not an unbounded pause.&lt;/span&gt;" vertex="1">
          <mxGeometry height="70" width="800" x="950" y="380" as="geometry" />
        </mxCell>
        <mxCell id="bp-b-mark" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d97706;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="30" width="5" x="70" y="495" as="geometry" />
        </mxCell>
        <mxCell id="bp-b-title" parent="1" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;fontFamily=Helvetica;" value="&lt;b&gt;B · Double-buffer producer / consumer handoff&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748b;&quot;&gt;State, not buffer address, defines ownership: FILLING belongs to producers; READY belongs to the Blackbox Task; FREE is reusable&lt;/span&gt;" vertex="1">
          <mxGeometry height="40" width="1400" x="85" y="490" as="geometry" />
        </mxCell>
        <mxCell id="bp-filling" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f8ff;strokeColor=#2563eb;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.3;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;Producer owns FILLING&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;append complete records&lt;br&gt;track current pos&lt;/span&gt;" vertex="1">
          <mxGeometry height="100" width="260" x="70" y="585" as="geometry" />
        </mxCell>
        <mxCell id="bp-full" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#d97706;fontFamily=Helvetica;fontColor=#0f172a;strokeWidth=1.3;" value="4 KiB block&lt;br&gt;complete?" vertex="1">
          <mxGeometry height="120" width="170" x="390" y="575" as="geometry" />
        </mxCell>
        <mxCell id="bp-next" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#d97706;fontFamily=Helvetica;fontColor=#0f172a;strokeWidth=1.3;" value="Other block&lt;br&gt;FREE?" vertex="1">
          <mxGeometry height="120" width="170" x="630" y="575" as="geometry" />
        </mxCell>
        <mxCell id="bp-publish" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf3;strokeColor=#f97316;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.35;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;Publish current block READY&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;release dataReady Semaphore&lt;br&gt;switch other block to FILLING&lt;br&gt;producer continues immediately&lt;/span&gt;" vertex="1">
          <mxGeometry height="120" width="300" x="870" y="575" as="geometry" />
        </mxCell>
        <mxCell id="bp-wait" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#7c3aed;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.35;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;Blackbox Task wakes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;Semaphore or 50 ms timeout&lt;br&gt;drain every READY block&lt;br&gt;poll file-control EventFlags&lt;/span&gt;" vertex="1">
          <mxGeometry height="120" width="270" x="1230" y="575" as="geometry" />
        </mxCell>
        <mxCell id="bp-process" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf3;strokeColor=#f97316;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.35;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" value="&lt;b style=&quot;font-family:Consolas,monospace;&quot;&gt;f_write(4096)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;success → FREE&lt;br&gt;failure → flag + drop block&lt;br&gt;then FREE to avoid deadlock&lt;/span&gt;" vertex="1">
          <mxGeometry height="120" width="190" x="1560" y="575" as="geometry" />
        </mxCell>
        <mxCell id="bp-continue" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfcfe;strokeColor=#94a3b8;fontFamily=Helvetica;fontColor=#475569;arcSize=6;strokeWidth=1.15;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;Continue current FILLING block&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;append the next complete record&lt;br&gt;no Semaphore release · no Task wake&lt;/span&gt;" vertex="1">
          <mxGeometry height="85" width="300" x="325" y="735" as="geometry" />
        </mxCell>
        <mxCell id="bp-overflow" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7f7;strokeColor=#dc2626;fontFamily=Helvetica;fontColor=#991b1b;arcSize=6;strokeWidth=1.3;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;Next block still READY / busy&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;set overflow flag · rollback bytes written by the current record · reject that record without leaving a partial frame&lt;/span&gt;" vertex="1">
          <mxGeometry height="85" width="540" x="630" y="735" as="geometry" />
        </mxCell>
        <mxCell id="bp-handoff-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fbf8;strokeColor=#16a34a;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;Scheduling effect&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;SD latency blocks only the Realtime4 Blackbox Task. FlightCtrl keeps producing until both finite RAM blocks are occupied.&lt;/span&gt;" vertex="1">
          <mxGeometry height="85" width="500" x="1230" y="735" as="geometry" />
        </mxCell>
        <mxCell id="bp-c-mark" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7c3aed;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="30" width="5" x="70" y="865" as="geometry" />
        </mxCell>
        <mxCell id="bp-c-title" parent="1" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;fontFamily=Helvetica;" value="&lt;b&gt;C · Asynchronous file lifecycle owned by Blackbox Task&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748b;&quot;&gt;ARM and calibration logic issue non-blocking requests; mount, open, retry, flush and close never execute in their callers&lt;/span&gt;" vertex="1">
          <mxGeometry height="40" width="1400" x="85" y="860" as="geometry" />
        </mxCell>
        <mxCell id="bp-idle" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfcfe;strokeColor=#94a3b8;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;No file open&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;wait forever on control EventFlags&lt;br&gt;zero idle polling&lt;/span&gt;" vertex="1">
          <mxGeometry height="105" width="240" x="70" y="955" as="geometry" />
        </mxCell>
        <mxCell id="bp-newreq" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f8ff;strokeColor=#2563eb;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.3;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;NEWFILE request&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;new Armed cycle or calibration session&lt;br&gt;EventFlags Set only&lt;/span&gt;" vertex="1">
          <mxGeometry height="105" width="250" x="370" y="955" as="geometry" />
        </mxCell>
        <mxCell id="bp-init" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#7c3aed;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.3;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b style=&quot;font-family:Consolas,monospace;&quot;&gt;BB_Init() + BufferInit()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;mount FatFS · choose first free LOG000…999.BIN&lt;br&gt;open file · retry failure every 500 ms&lt;/span&gt;" vertex="1">
          <mxGeometry height="105" width="320" x="680" y="955" as="geometry" />
        </mxCell>
        <mxCell id="bp-active" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fbf8;strokeColor=#16a34a;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.3;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;File-open service loop&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;WaitReady(50 ms) · drain READY blocks&lt;br&gt;PollControlRequest(0)&lt;br&gt;monitor sticky error flags&lt;/span&gt;" vertex="1">
          <mxGeometry height="105" width="300" x="1060" y="955" as="geometry" />
        </mxCell>
        <mxCell id="bp-close-req" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f8ff;strokeColor=#2563eb;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.3;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;CLOSE request&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;Disarm or calibration finish&lt;br&gt;EventFlags Set only&lt;/span&gt;" vertex="1">
          <mxGeometry height="105" width="240" x="1420" y="955" as="geometry" />
        </mxCell>
        <mxCell id="bp-close" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf3;strokeColor=#f97316;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.3;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" value="&lt;b&gt;Drain + close&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;write all READY&lt;br&gt;write FILLING tail&lt;br&gt;f_sync → f_close&lt;br&gt;publish close result&lt;/span&gt;" vertex="1">
          <mxGeometry height="120" width="170" x="1580" y="1110" as="geometry" />
        </mxCell>
        <mxCell id="bp-lifecycle-invariant" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#d97706;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;Single-writer invariant&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;Only App_Blackbox_Task calls BB_Init(), BB_Process() and BB_Close(). Other tasks can request lifecycle changes, but never touch FIL/FATFS state.&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="1150" x="70" y="1125" as="geometry" />
        </mxCell>
        <mxCell id="bp-d-mark" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f97316;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="30" width="5" x="70" y="1270" as="geometry" />
        </mxCell>
        <mxCell id="bp-d-title" parent="1" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;fontFamily=Helvetica;" value="&lt;b&gt;D · Integrity signals and offline engineering loop&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748b;&quot;&gt;The file is a versioned engineering interface, not a byte dump: resynchronization, units and fault context are preserved&lt;/span&gt;" vertex="1">
          <mxGeometry height="40" width="1400" x="85" y="1265" as="geometry" />
        </mxCell>
        <mxCell id="bp-contract" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#d97706;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.3;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;Binary protocol contract&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;MAGIC permits byte-wise resynchronization&lt;br&gt;TYPE selects versioned Packed Layout&lt;br&gt;fixed-point units and bit flags carry meaning&lt;/span&gt;" vertex="1">
          <mxGeometry height="125" width="360" x="70" y="1360" as="geometry" />
        </mxCell>
        <mxCell id="bp-error" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7f7;strokeColor=#dc2626;fontFamily=Helvetica;fontColor=#991b1b;arcSize=6;strokeWidth=1.3;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;Sticky integrity flags&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;bit0 = double-buffer overflow&lt;br&gt;bit1 = SD write failure&lt;br&gt;both mean the file is incomplete even if logging continues&lt;/span&gt;" vertex="1">
          <mxGeometry height="125" width="360" x="500" y="1360" as="geometry" />
        </mxCell>
        <mxCell id="bp-indicator" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#7c3aed;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.3;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;Operator-visible error edge&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;0 → nonzero error transition queues EVT_SD_CARD_ERROR once&lt;br&gt;avoids flooding IndicatorEventQueue&lt;/span&gt;" vertex="1">
          <mxGeometry height="125" width="360" x="930" y="1360" as="geometry" />
        </mxCell>
        <mxCell id="bp-offline" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fbf8;strokeColor=#16a34a;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.35;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;LOGxxx.BIN → offline tools&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;parse records + restore engineering units&lt;br&gt;export CSV / plot Control and Navigation traces&lt;br&gt;correlate targets, state, output and fault events&lt;/span&gt;" vertex="1">
          <mxGeometry height="125" width="390" x="1360" y="1360" as="geometry" />
        </mxCell>
        <mxCell id="bp-final" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f8ff;strokeColor=#2563eb;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="Engineering closure: the same timestamped record ties an observed flight symptom to estimator state, controller terms, motor authority and system events." vertex="1">
          <mxGeometry height="65" width="1680" x="70" y="1525" as="geometry" />
        </mxCell>
        <mxCell id="bp-legend" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#475569;fontFamily=Helvetica;" value="Blue = producer interface · Amber = buffer / protocol contract · Purple = background Task / event handoff · Orange = storage · Red = integrity loss" vertex="1">
          <mxGeometry height="25" width="1060" x="70" y="1630" as="geometry" />
        </mxCell>
        <mxCell id="bp-rtos-link" parent="1" link="data:page/id,rtos" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=1;fontColor=#2563eb;fontFamily=Helvetica;" value="← 02 · RTOS / IPC" vertex="1">
          <mxGeometry height="25" width="190" x="1290" y="1630" as="geometry" />
        </mxCell>
        <mxCell id="bp-flight-link" parent="1" link="data:page/id,flight" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=1;fontColor=#2563eb;fontFamily=Helvetica;" value="← 03 · FlightCtrl" vertex="1">
