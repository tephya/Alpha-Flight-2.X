  <diagram id="blackbox-persistence" name="12 Blackbox Persistence and Offline Diagnosis">
    <mxGraphModel dx="1420" dy="794" grid="1" gridSize="5" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1680" math="0" shadow="0" background="#ffffff">
      <root>
