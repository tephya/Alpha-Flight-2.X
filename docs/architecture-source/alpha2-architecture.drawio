  <diagram id="control-actuation" name="11 Control Mixer and DShot Output">
    <mxGraphModel dx="1202" dy="926" grid="1" gridSize="5" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1700" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ca-title-accent" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0f766e;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="40" width="5" x="30" y="25" as="geometry" />
        </mxCell>
        <mxCell id="ca-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#0f172a;fontFamily=Helvetica;" value="Control, Mixer &amp; DShot Output" vertex="1">
          <mxGeometry height="45" width="1000" x="45" y="25" as="geometry" />
        </mxCell>
        <mxCell id="ca-sub" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#64748b;fontFamily=Helvetica;" value="One time-valid Active IMU frame · target selection → nested control → de-saturation → synchronous four-channel emission" vertex="1">
          <mxGeometry height="20" width="1250" x="45" y="70" as="geometry" />
        </mxCell>
        <mxCell id="ca-page-label" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=1;fontColor=#64748b;fontFamily=Helvetica;" value="11 · CONTROL / MIXER / DSHOT" vertex="1">
          <mxGeometry height="25" width="390" x="1340" y="35" as="geometry" />
        </mxCell>
        <mxCell id="ca-a-mark" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2563eb;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="30" width="5" x="70" y="115" as="geometry" />
        </mxCell>
        <mxCell id="ca-a-title" parent="1" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;fontFamily=Helvetica;" value="&lt;b&gt;A · Canonical ARMED control-cycle chain&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748b;&quot;&gt;FlightControl_Update() is bypassed unless Arm_Update() still reports ARMED in the current valid-frame cycle&lt;/span&gt;" vertex="1">
          <mxGeometry height="40" width="1250" x="85" y="110" as="geometry" />
        </mxCell>
        <mxCell id="ca-targets" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f8ff;strokeColor=#2563eb;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;Select current-cycle targets&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;Roll/Pitch: RC or Horizontal controller&lt;br&gt;Yaw: Manual Rate or Heading Hold&lt;br&gt;Throttle: mapped RC collective&lt;/span&gt;" vertex="1">
          <mxGeometry height="135" width="300" x="70" y="205" as="geometry" />
        </mxCell>
        <mxCell id="ca-outer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fbf8;strokeColor=#16a34a;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;Convert attitude targets to rates&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;AngleController_Update(): Roll/Pitch angle error → rate target&lt;br&gt;YawHeadingHold_Update(): wrapped heading error → Yaw rate target&lt;/span&gt;" vertex="1">
          <mxGeometry height="135" width="330" x="430" y="205" as="geometry" />
        </mxCell>
        <mxCell id="ca-rate" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fbf8;strokeColor=#16a34a;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b style=&quot;font-family:Consolas,monospace;&quot;&gt;RateController_Update()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;rate target − Gyro measurement&lt;br&gt;PID + optional Roll/Pitch Feedforward&lt;br&gt;→ roll_cmd · pitch_cmd · yaw_cmd&lt;/span&gt;" vertex="1">
          <mxGeometry height="135" width="320" x="820" y="205" as="geometry" />
        </mxCell>
        <mxCell id="ca-mixer-main" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#d97706;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;Apply collective authority + Mixer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;Power limit scales throttle only&lt;br&gt;attitude differential remains independent&lt;br&gt;de-saturate → m1…m4&lt;/span&gt;" vertex="1">
          <mxGeometry height="135" width="300" x="1200" y="205" as="geometry" />
        </mxCell>
        <mxCell id="ca-dshot-main" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf3;strokeColor=#f97316;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" value="&lt;b style=&quot;font-family:Consolas,monospace;&quot;&gt;BSP_DSHOT_Send()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;normal: m + 48&lt;br&gt;safe path: 0&lt;br&gt;4 synchronized channels&lt;/span&gt;" vertex="1">
          <mxGeometry height="135" width="190" x="1560" y="205" as="geometry" />
        </mxCell>
        <mxCell id="ca-armed-contract" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7f7;strokeColor=#dc2626;fontFamily=Helvetica;fontColor=#991b1b;arcSize=6;strokeWidth=1.25;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;Immediate cut-through safety path&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Disarm, calibration, dual fault or repeated timing anomaly resets control state and publishes DShot 0 without entering this chain.&lt;/span&gt;" vertex="1">
          <mxGeometry height="75" width="720" x="70" y="385" as="geometry" />
        </mxCell>
        <mxCell id="ca-authority" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#d97706;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.25;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;Current-limit contract&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;current_limit_permille is accepted only in [600,1000]; otherwise 1000. It changes collective throttle, not Roll/Pitch/Yaw correction authority.&lt;/span&gt;" vertex="1">
          <mxGeometry height="75" width="720" x="1030" y="385" as="geometry" />
        </mxCell>
        <mxCell id="ca-b-mark" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#16a34a;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="30" width="5" x="70" y="505" as="geometry" />
        </mxCell>
        <mxCell id="ca-b-title" parent="1" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;fontFamily=Helvetica;" value="&lt;b&gt;B · PID kernel used by Angle, Rate and Heading controllers&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748b;&quot;&gt;The same stateful kernel changes behavior through gains, output limits, Feedforward and Integral Growth Scale&lt;/span&gt;" vertex="1">
          <mxGeometry height="40" width="1300" x="85" y="500" as="geometry" />
        </mxCell>
        <mxCell id="ca-pid-input" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f8ff;strokeColor=#2563eb;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.3;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;State and inputs&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,monospace;font-size:11px;color:#475569;&quot;&gt;target · measurement · dt&lt;br&gt;Kp · Ki · Kd · ff&lt;br&gt;integral / output limits&lt;/span&gt;" vertex="1">
          <mxGeometry height="130" width="250" x="70" y="585" as="geometry" />
        </mxCell>
        <mxCell id="ca-pid-i" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fbf8;strokeColor=#16a34a;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.3;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;Error + conditional integration&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;error = target − measurement&lt;br&gt;stop growth when output is saturated in the same direction&lt;br&gt;always allow Integral unwind&lt;/span&gt;" vertex="1">
          <mxGeometry height="130" width="320" x="375" y="585" as="geometry" />
        </mxCell>
        <mxCell id="ca-pid-d" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fbf8;strokeColor=#16a34a;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.3;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;Derivative on measurement&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,monospace;font-size:11px;color:#475569;&quot;&gt;D_raw = (last_meas − meas) / dt&lt;br&gt;D_lpf = 0.2·D_raw + 0.8·D_lpf&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;avoids Target-step Derivative Kick&lt;/span&gt;" vertex="1">
          <mxGeometry height="130" width="320" x="750" y="585" as="geometry" />
        </mxCell>
        <mxCell id="ca-pid-sum" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f8ff;strokeColor=#2563eb;fontFamily=Consolas;fontColor=#1d4ed8;arcSize=6;strokeWidth=1.3;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;pre_out&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;Kp·error&lt;br&gt;+ Ki·integral&lt;br&gt;+ Kd·D_lpf&lt;br&gt;+ Feedforward&lt;/span&gt;" vertex="1">
          <mxGeometry height="130" width="245" x="1125" y="585" as="geometry" />
        </mxCell>
        <mxCell id="ca-pid-sat" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#d97706;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.3;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;Saturate + Back-Calculation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;clamp output to configured authority&lt;br&gt;convert excess output back through Ki&lt;br&gt;re-clamp persistent Integral state&lt;/span&gt;" vertex="1">
          <mxGeometry height="130" width="300" x="1430" y="585" as="geometry" />
        </mxCell>
        <mxCell id="ca-ff-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f8ff;strokeColor=#94a3b8;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;Position Hold Rate Feedforward&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;Roll 0.50 · Pitch 0.40 · each limited to ±10; disabled in Manual and Velocity Hold.&lt;/span&gt;" vertex="1">
          <mxGeometry height="75" width="500" x="70" y="755" as="geometry" />
        </mxCell>
        <mxCell id="ca-yaw-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f8ff;strokeColor=#94a3b8;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;Yaw Integral Growth Scale&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;Full growth below 5 deg/s; progressively relaxed to zero by 20 deg/s. Existing Integral can still unwind.&lt;/span&gt;" vertex="1">
          <mxGeometry height="75" width="500" x="650" y="755" as="geometry" />
        </mxCell>
        <mxCell id="ca-dt-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f8ff;strokeColor=#94a3b8;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;Numerical guardrails&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;PID clamps dt to at least 0.5 ms and aligns the first historical measurement before evaluating D.&lt;/span&gt;" vertex="1">
          <mxGeometry height="75" width="500" x="1230" y="755" as="geometry" />
        </mxCell>
        <mxCell id="ca-c-mark" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d97706;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="30" width="5" x="70" y="875" as="geometry" />
        </mxCell>
        <mxCell id="ca-c-title" parent="1" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;fontFamily=Helvetica;" value="&lt;b&gt;C · Quad-X mixer authority and de-saturation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748b;&quot;&gt;Preserve the direction and relative ratio of Roll/Pitch/Yaw correction before applying the final motor limits&lt;/span&gt;" vertex="1">
          <mxGeometry height="40" width="1250" x="85" y="870" as="geometry" />
        </mxCell>
        <mxCell id="ca-correction" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f8ff;strokeColor=#2563eb;fontFamily=Consolas;fontColor=#1d4ed8;arcSize=6;strokeWidth=1.3;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;Build differential vector&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;c1 = −P − R + Y&lt;br&gt;c2 = +P − R − Y&lt;br&gt;c3 = −P + R − Y&lt;br&gt;c4 = +P + R + Y&lt;/span&gt;" vertex="1">
          <mxGeometry height="135" width="330" x="70" y="970" as="geometry" />
        </mxCell>
        <mxCell id="ca-range" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#d97706;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.3;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;Scale correction span if needed&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;if max(c) − min(c) &gt; 1352 − 110:&lt;br&gt;scale every c[i] by the same factor&lt;br&gt;→ preserve axis ratios before clipping&lt;/span&gt;" vertex="1">
          <mxGeometry height="135" width="320" x="470" y="970" as="geometry" />
        </mxCell>
        <mxCell id="ca-airmode" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#d97706;fontFamily=Helvetica;fontColor=#0f172a;strokeWidth=1.3;" value="Airmode&lt;br&gt;enabled?" vertex="1">
          <mxGeometry height="130" width="180" x="855" y="972" as="geometry" />
        </mxCell>
        <mxCell id="ca-shift" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fbf8;strokeColor=#16a34a;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.3;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;Shift shared collective&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;choose collective within&lt;br&gt;[110 − min(c), 1352 − max(c)]&lt;br&gt;to retain differential authority&lt;/span&gt;" vertex="1">
          <mxGeometry height="115" width="330" x="1110" y="925" as="geometry" />
        </mxCell>
        <mxCell id="ca-no-shift" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfcfe;strokeColor=#94a3b8;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;Do not raise collective&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;clamp base throttle to [110,1352];&lt;br&gt;final per-motor limits handle overflow&lt;/span&gt;" vertex="1">
          <mxGeometry height="105" width="330" x="1110" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="ca-mix-merge" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#64748b;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="10" width="10" x="1495" y="1032" as="geometry" />
        </mxCell>
        <mxCell id="ca-motor-values" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf3;strokeColor=#f97316;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.35;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" value="&lt;b&gt;Clamp four outputs&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,monospace;font-size:11px;color:#475569;&quot;&gt;m[i] = clamp(&lt;br&gt;collective + c[i],&lt;br&gt;110, 1352)&lt;/span&gt;" vertex="1">
          <mxGeometry height="120" width="190" x="1560" y="977" as="geometry" />
        </mxCell>
        <mxCell id="ca-d-mark" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f97316;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="30" width="5" x="70" y="1235" as="geometry" />
        </mxCell>
        <mxCell id="ca-d-title" parent="1" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;fontFamily=Helvetica;" value="&lt;b&gt;D · DShot600 frame construction and TIM1 DMA Burst emission&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748b;&quot;&gt;The CPU prepares the next frame; TIM1 Update events emit all four channels at identical bit boundaries&lt;/span&gt;" vertex="1">
          <mxGeometry height="40" width="1300" x="85" y="1230" as="geometry" />
        </mxCell>
        <mxCell id="ca-dshot-input" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f8ff;strokeColor=#2563eb;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.3;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;Select four payloads&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;normal: m1…m4 + 48&lt;br&gt;safety / Disarmed: 0,0,0,0&lt;br&gt;Telemetry request bit = 0&lt;/span&gt;" vertex="1">
          <mxGeometry height="115" width="270" x="70" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="ca-encode" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf3;strokeColor=#f97316;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.3;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b style=&quot;font-family:Consolas,monospace;&quot;&gt;DSHOT_EncodeFrame()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;11-bit Payload · 1-bit Telemetry&lt;br&gt;4-bit XOR checksum&lt;br&gt;→ one 16-bit frame per motor&lt;/span&gt;" vertex="1">
          <mxGeometry height="115" width="300" x="400" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="ca-buffer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf3;strokeColor=#f97316;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.3;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;Expand interleaved DMA buffer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;MSB-first · [bit15 CH1…CH4] … [bit0 CH1…CH4]&lt;br&gt;CCR 105 = logic 0 · CCR 210 = logic 1&lt;br&gt;append 2 all-zero periods · DMA_SAFE_SRAM&lt;/span&gt;" vertex="1">
          <mxGeometry height="115" width="370" x="760" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="ca-dma" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#7c3aed;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.35;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;TIM1 Update → DMA Burst&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;18 groups × 4 Halfword writes&lt;br&gt;CCR1 → CCR4 each bit period&lt;br&gt;no per-channel software timing loop&lt;/span&gt;" vertex="1">
          <mxGeometry height="115" width="330" x="1190" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="ca-esc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf3;strokeColor=#f97316;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.35;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" value="&lt;b&gt;4 × ESC&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;CH1…CH4&lt;br&gt;synchronous&lt;br&gt;DShot600 waveform&lt;/span&gt;" vertex="1">
          <mxGeometry height="115" width="170" x="1580" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="ca-busy" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fbf8;strokeColor=#16a34a;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;Non-blocking latest-frame policy&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;If the previous DMA Burst is unexpectedly Busy, stop it and publish the newest frame; never Busy Wait in the control path.&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="510" x="70" y="1480" as="geometry" />
        </mxCell>
        <mxCell id="ca-wave" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f8ff;strokeColor=#94a3b8;fontFamily=Helvetica;fontColor=#0f172a;arcSize=6;strokeWidth=1.15;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;Timing contract&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;One DShot bit = 280 TIM1 counts; logic value changes High Time only, while the bit period remains fixed.&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="510" x="645" y="1480" as="geometry" />
        </mxCell>
        <mxCell id="ca-gap" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7f7;strokeColor=#dc2626;fontFamily=Helvetica;fontColor=#991b1b;arcSize=6;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=10;" value="&lt;b&gt;Known diagnostic gap&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;HAL_TIM_DMABurst_MultiWriteStart() failure is detected, but the current source still leaves the Blackbox / Health counter as TODO.&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="510" x="1220" y="1480" as="geometry" />
        </mxCell>
        <mxCell id="ca-legend" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#475569;fontFamily=Helvetica;" value="Blue = target / state interface · Green = feedback control · Amber = authority / de-saturation · Orange = DShot · Purple = hardware DMA" vertex="1">
          <mxGeometry height="25" width="1000" x="70" y="1640" as="geometry" />
