        <mxCell id="yb-metrics" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f8ff;strokeColor=#2563eb;fontFamily=Consolas;fontColor=#1d4ed8;arcSize=6;strokeWidth=1.35;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;Compute gate metrics&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;&quot;&gt;field_ratio = |M| / field_reference&lt;br&gt;innovation = WrapPi(mag_yaw - yaw)&lt;/span&gt;" vertex="1">
